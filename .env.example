# MLflow tracking server used by both the Airflow tasks and the local CLI.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Experiment name that Airflow and local runs write into.
MLFLOW_EXPERIMENT_NAME=wine-quality-classification

# Dataset (project-relative unless absolute paths are required).
WINE_QUALITY_CSV=winequality-red.csv
# WINE_QUALITY_DATA_FILE=data/winequality-red.csv

# quality >= threshold is "good" (1); below is "not_good" (0).
WINE_QUALITY_THRESHOLD=6
WINE_QUALITY_RANDOM_STATE=42
WINE_QUALITY_TEST_SIZE=0.2

# Hyperparameters
LOGREG_C=1.0
LOGREG_MAX_ITER=1000
RF_N_ESTIMATORS=300
RF_MAX_DEPTH=10

# Silence the MLflow agent hint notice
MLFLOW_DISABLE_AGENT_HINT=1
